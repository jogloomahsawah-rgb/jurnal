rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // An admin is any user whose UID exists as a document in /admins (created by hand in the console).
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow delete: if isAdmin();
    }

    match /settings/{doc} {
      allow read, write: if isAdmin();
    }

    match /articles/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /posts/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();

      match /replies/{rid} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'content', 'isAdmin', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 600
          && request.resource.data.isAdmin == isAdmin()
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      }

      match /reactions/{uid} {
        allow read: if true;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['type', 'uid', 'createdAt'])
          && request.resource.data.type in ['fire', 'heart', 'like']
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
